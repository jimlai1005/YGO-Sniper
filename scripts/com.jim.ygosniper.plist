<?xml version="1.0" encoding="UTF-8"?>
<!--
  安裝／改完之後重載：
    cp scripts/com.jim.ygosniper.plist ~/Library/LaunchAgents/
    launchctl unload ~/Library/LaunchAgents/com.jim.ygosniper.plist
    launchctl load   ~/Library/LaunchAgents/com.jim.ygosniper.plist

  ── 為什麼是 StartCalendarInterval 而不是 StartInterval 3600 ──

  兩者都能做到「每小時一次」，差別全在 MBP 蓋起來睡著的時候：

  * StartInterval 3600 是相對計時：睡眠期間不計時，醒來後從頭再數 3600 秒。
    也就是說闔上蓋子 5 小時，醒來後還要再等最多一小時才會跑第一次。
  * StartCalendarInterval 給一組時間點（見下方 array）。
    睡眠期間錯過的排程，launchd 會在醒來後**立刻補跑一次**（只補一次，
    不會把錯過的 5 次全部補齊）。

  對「狙擊新上架」這個目的，這個取捨是有方向性的：
  補跑一次「五小時前那一輪」本身沒有價值（那批貨早就被人撿走或已不新），
  但「醒來後立刻跑一次」很有價值——它抓的是當下的最新狀態，而且讓你闔蓋
  再打開就有結果，不必乾等一小時。兩個效果由同一個機制提供，所以選它。

  想改時段改 schedule_watch._WINDOWS（網格不在這支 plist，見下方 StartCalendarInterval 的說明）。
  改這支 plist 本身要 unload 再 load 一次才生效。
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jim.ygosniper</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>$HOME/projects/ygo-sniper/scripts/run_daily.sh</string>
    </array>

    <!--
      ── 2026-10-21 起：launchd 只負責「每 15 分鐘叫醒一次」，網格不寫在這裡 ──

      網格（台北時間）定義在 src/ygo_sniper/schedule_watch.py 的 `_WINDOWS`，唯一一處：
        09:30-17:30 每 2 小時（抓新上架）、18:00-22:30 每 30 分（結標高峰：實測 63 筆
        競標全部在台灣時間 18-22 點結標）、23:00-08:00 不跑。
      run_daily.sh 取鎖之前先跑 `ygo-sniper slot-check（band=std）`：台北現在落在網格上
      （±7 分容忍喚醒漂移），或上一輪之後有網格被跳過（筆電睡醒補觸發）→ 往下掃；
      否則靜默結束（exit 0、不寫 log、不碰鎖、不碰帳本）。

      為什麼不再把 Hour/Minute 寫在這裡：StartCalendarInterval 的牆上時間由 launchd 依
      「系統時區」解讀，使用者旅行時 macOS 會自動換時區（2026-10 Dallas → LA → 台北），
      launchd 的網格就與 Python 的台北時鐘脫鉤——連續 12 天每天假報「漏跑 9-10 個時段」
      （CLAUDE.md 第三節第九事故）。現在 launchd 不知道網格，時區怎麼換都不影響。
      想改時段：改 `_WINDOWS`，不要改這裡。Hour 鍵刻意不寫（省略＝每小時都觸發）。
    -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>0</integer></dict>
        <dict><key>Minute</key><integer>15</integer></dict>
        <dict><key>Minute</key><integer>30</integer></dict>
        <dict><key>Minute</key><integer>45</integer></dict>
    </array>

    <!-- 載入時不要立刻跑一次，等排程時間到（最多等 1 小時，可接受） -->
    <key>RunAtLoad</key>
    <false/>

    <!-- 掛掉不要無限重啟；跑不完就等下一個整點半，不要疊上去 -->
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/ygosniper.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ygosniper.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
        <!-- 與 run_daily.sh／run_high.sh 開頭的 export TZ 雙保險：排程相關的牆上時間一律台北 -->
        <key>TZ</key>
        <string>Asia/Taipei</string>
        <!-- 只有 launchd 觸發才啟用 run_*.sh 的 slot-check 閘門；dashboard 補跑與手動執行不設，永遠直接掃 -->
        <key>YGO_SLOT_GATE</key>
        <string>1</string>
    </dict>

    <!--
      節流：避免同一分鐘內被重複觸發。
      刻意**不**設成 3600：排程本身就是每 3600 秒一次，兩者相等時只要有一點點
      抖動（睡眠喚醒後的補跑尤其明顯）就會把一次合法的執行整個吃掉。
      300 秒足以擋掉重複觸發，又不會跟每小時的排程打架。
      真正防「上一輪還在跑就又開一輪」的是 run_daily.sh 裡的鎖，不是這個值。
    -->
    <key>ThrottleInterval</key>
    <integer>300</integer>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
