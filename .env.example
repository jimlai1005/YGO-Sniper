# 複製成 .env 再填。.env 已經在 .gitignore 裡，不會被 commit。

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# eBay Developer Program 憑證。空著的話 eBay 來源會自動停用，
# 其他部分照常運作。拿到之後填進來，下次 scan 就會自動啟用。
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# PSA public API（狙擊卡 PSA 存世量用；https://www.psacard.com/publicapi 免費註冊，100 次/天）
PSA_API_TOKEN=
